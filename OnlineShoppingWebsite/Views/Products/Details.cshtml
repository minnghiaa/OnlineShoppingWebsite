@model OnlineShoppingWebsite.Models.Product

@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<div class="auth-wrapper" style="max-width: 760px;">
    <div style="margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h2 style="font-size: 1.5rem; margin-bottom: 0.25rem;">Chi tiết sản phẩm</h2>
            <p style="color: var(--text-muted); font-size: 0.875rem; margin: 0;">Mã sản phẩm: #@Model.ProductID</p>
        </div>
        <div>
            @Html.ActionLink("Sửa sản phẩm", "Edit", new { id = Model.ProductID }, new { @class = "btn btn-primary btn-sm" })
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-outline btn-sm" })
        </div>
    </div>

    <!-- ẢNH SẢN PHẨM (CHUẨN B05) -->
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <div style="text-align: center; margin-bottom: 1.5rem;">
            <img src="@Url.Content("~/Content/images/" + Model.ImageUrl)"
                 alt="@Model.ProductName"
                 style="width: 220px; height: 260px; object-fit: cover; border-radius: var(--radius-md); border: 1px solid var(--border-subtle); box-shadow: var(--shadow-md);"
                 onerror="this.src='https://placehold.co/400x500/f1f5f9/334155?text=Ảnh';" />
        </div>
    }

    <!-- BẢNG THÔNG TIN CHI TIẾT TIẾNG VIỆT -->
    <table class="table-custom" style="width: 100%;">
        <tbody>
            <tr>
                <td style="width: 160px; font-weight: 700; color: var(--text-muted);">Tên sản phẩm:</td>
                <td><strong style="color: var(--color-primary); font-size: 1.05rem;">@Model.ProductName</strong></td>
            </tr>
            <tr>
                <td style="font-weight: 700; color: var(--text-muted);">Danh mục:</td>
                <td>
                    <span style="background: var(--bg-surface-secondary); padding: 0.2rem 0.6rem; border-radius: var(--radius-sm); font-weight: 600;">
                        @(Model.Category != null ? Model.Category.CategoryName : "N/A")
                    </span>
                </td>
            </tr>
            <tr>
                <td style="font-weight: 700; color: var(--text-muted);">Đơn giá:</td>
                <td><strong style="color: var(--color-danger); font-size: 1.125rem;">@Model.Price.ToString("#,##0") đ</strong></td>
            </tr>
            <tr>
                <td style="font-weight: 700; color: var(--text-muted);">Số lượng tồn kho:</td>
                <td>
                    @if (Model.StockQuantity > 0)
                    {
                        <span style="color: var(--color-success); font-weight: 700;">@Model.StockQuantity sản phẩm</span>
                    }
                    else
                    {
                        <span class="status-badge status-cancelled">Hết hàng (0)</span>
                    }
                </td>
            </tr>
            <tr>
                <td style="font-weight: 700; color: var(--text-muted);">Trạng thái:</td>
                <td>
                    @if (Model.IsActive)
                    {
                        <span class="status-badge status-completed">Đang bán</span>
                    }
                    else
                    {
                        <span class="status-badge status-cancelled">Ngừng bán</span>
                    }
                </td>
            </tr>
            <tr>
                <td style="font-weight: 700; color: var(--text-muted); vertical-align: top;">Mô tả chi tiết:</td>
                <td style="line-height: 1.7; color: var(--text-secondary);">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "Chưa có mô tả." : Model.Description)
                </td>
            </tr>
        </tbody>
    </table>

    <div style="display: flex; gap: 1rem; margin-top: 2rem;">
        <a href="@Url.Action("Edit", new { id = Model.ProductID })" class="btn btn-primary" style="flex: 1;">
            <i class="fa-solid fa-pen-to-square"></i> Sửa sản phẩm này
        </a>
        <a href="@Url.Action("Index")" class="btn btn-outline">
            Quay lại danh sách
        </a>
    </div>
</div>
