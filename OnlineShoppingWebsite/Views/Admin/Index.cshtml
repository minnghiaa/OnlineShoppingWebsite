@using System.Collections.Generic
@using System.Linq
@{
    ViewBag.Title = "Bảng Điều Khiển Quản Trị";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
    var recentOrders = ViewBag.RecentOrders as IEnumerable<OnlineShoppingWebsite.Models.OrderPro> ?? new List<OnlineShoppingWebsite.Models.OrderPro>();

    string GetVnStatus(string status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "Chờ xử lý";
        status = status.Trim();
        if (status.Equals("Pending", StringComparison.OrdinalIgnoreCase) || status.Contains("?") || status.Equals("Chờ xử lý", StringComparison.OrdinalIgnoreCase))
            return "Chờ xử lý";
        if (status.Equals("Confirmed", StringComparison.OrdinalIgnoreCase) || status.Equals("Đã xác nhận", StringComparison.OrdinalIgnoreCase))
            return "Đã xác nhận";
        if (status.Equals("Shipping", StringComparison.OrdinalIgnoreCase) || status.Equals("Đang giao", StringComparison.OrdinalIgnoreCase))
            return "Đang giao";
        if (status.Equals("Completed", StringComparison.OrdinalIgnoreCase) || status.Equals("Hoàn thành", StringComparison.OrdinalIgnoreCase))
            return "Hoàn thành";
        if (status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase) || status.Equals("Đã hủy", StringComparison.OrdinalIgnoreCase))
            return "Đã hủy";
        return status;
    }
}

<div class="admin-dashboard-wrapper">
    <!-- 1. HERO HEADER SECTION -->
    <header class="admin-hero-card">
        <div class="admin-hero-left">
            <div class="admin-shield-badge">
                <i class="fa-solid fa-shield-halved"></i>
                <span>QUẢN TRỊ VIÊN HỆ THỐNG</span>
            </div>
            <h1 class="admin-hero-title">Bảng Điều Khiển Quản Trị</h1>
        </div>
        <div class="admin-hero-actions">
            <a href="@Url.Action("Index", "Store")" class="adm-btn adm-btn-outline" target="_blank" title="Mở trang cửa hàng cho khách xem">
                <i class="fa-solid fa-store"></i>
                <span>Xem Cửa Hàng</span>
            </a>
        </div>
    </header>

    <!-- 2. KHU VỰC QUẢN LÝ TRỌNG TÂM (ĐƯỢC ĐƯA LÊN THAY THẾ 4 Ô NHỎ) -->
    <section class="admin-modules-section">
        <div class="section-title-wrap">
            <div class="section-title-left">
                <h2 class="admin-section-heading">
                    <i class="fa-solid fa-sliders"></i>
                    <span>Khu Vực Quản Lý Trọng Tâm</span>
                </h2>
                <p class="admin-section-sub">Truy cập nhanh các phân hệ chức năng cốt lõi theo bài học quản trị</p>
            </div>
        </div>

        <div class="admin-modules-grid">
            <!-- Module 1: Quản lý Sản Phẩm -->
            <div class="adm-module-card">
                <div class="adm-module-badge badge-blue">Kho Hàng</div>
                <div class="adm-module-icon-wrap icon-blue">
                    <i class="fa-solid fa-shirt"></i>
                </div>
                <h3 class="adm-module-title">Quản Lý Sản Phẩm</h3>
                <div class="adm-module-stat">
                    <i class="fa-solid fa-circle-check" style="color: #16a34a;"></i>
                    <span><strong>@ViewBag.TotalProducts</strong> sản phẩm (@ViewBag.ActiveProducts đang bán)</span>
                </div>
                <p class="adm-module-desc">
                    Quản lý danh sách mẫu áo, quần, đầm thời trang; chỉnh sửa giá niêm yết, số lượng tồn kho và cập nhật hình ảnh sản phẩm.
                </p>
                <div class="adm-module-actions">
                    <a href="@Url.Action("Index", "Products")" class="module-btn-primary">
                        <span>Danh Sách Sản Phẩm</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                    <a href="@Url.Action("Create", "Products")" class="module-btn-sub">
                        <i class="fa-solid fa-plus"></i> Thêm Mẫu Mới
                    </a>
                </div>
            </div>

            <!-- Module 2: Quản lý Danh Mục -->
            <div class="adm-module-card">
                <div class="adm-module-badge badge-purple">Phân Loại</div>
                <div class="adm-module-icon-wrap icon-purple">
                    <i class="fa-solid fa-layer-group"></i>
                </div>
                <h3 class="adm-module-title">Quản Lý Danh Mục</h3>
                <div class="adm-module-stat">
                    <i class="fa-solid fa-folder-open" style="color: #9333ea;"></i>
                    <span><strong>@ViewBag.TotalCategories</strong> danh mục thời trang</span>
                </div>
                <p class="adm-module-desc">
                    Tổ chức cây phân loại sản phẩm (Áo thiết kế, Quần &amp; Chân váy, Đầm dự tiệc, Phụ kiện); thêm mới và cập nhật danh mục.
                </p>
                <div class="adm-module-actions">
                    <a href="@Url.Action("Index", "Categories")" class="module-btn-primary">
                        <span>Xem Danh Mục</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                    <a href="@Url.Action("Create", "Categories")" class="module-btn-sub">
                        <i class="fa-solid fa-plus"></i> Tạo Danh Mục
                    </a>
                </div>
            </div>

            <!-- Module 3: Quản lý Đơn Hàng -->
            <div class="adm-module-card">
                <div class="adm-module-badge badge-amber">Bán Hàng</div>
                <div class="adm-module-icon-wrap icon-amber">
                    <i class="fa-solid fa-receipt"></i>
                </div>
                <h3 class="adm-module-title">Quản Lý Đơn Hàng</h3>
                <div class="adm-module-stat">
                    <i class="fa-solid fa-hourglass-half" style="color: #d97706;"></i>
                    <span><strong>@ViewBag.TotalOrders</strong> đơn hàng (@ViewBag.PendingOrders đơn chờ duyệt)</span>
                </div>
                <p class="adm-module-desc">
                    Theo dõi khách đặt mua, tiếp nhận đơn chờ xử lý, điều chỉnh trạng thái vận chuyển (COD) và in phiếu hóa đơn chi tiết.
                </p>
                <div class="adm-module-actions">
                    <a href="@Url.Action("Index", "Orders")" class="module-btn-primary">
                        <span>Xem Tất Cả Đơn</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                    <a href="@Url.Action("Index", "Orders", new { status = "Chờ xử lý" })" class="module-btn-sub">
                        <i class="fa-solid fa-clock"></i> Đơn Chờ Duyệt (@ViewBag.PendingOrders)
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. BẢNG ĐƠN HÀNG MỚI ĐẶT GẦN ĐÂY -->
    @if (recentOrders.Any())
    {
        <section class="admin-recent-card">
            <div class="admin-recent-header">
                <div>
                    <h3 class="recent-title">
                        <i class="fa-solid fa-bell" style="color: var(--color-accent, #c29958);"></i>
                        Đơn Hàng Mới Đặt Gần Đây
                    </h3>
                    <p class="recent-desc">Các đơn hàng mới nhất phát sinh từ khách thành viên và khách vãng lai</p>
                </div>
                <a href="@Url.Action("Index", "Orders")" class="adm-btn adm-btn-outline adm-btn-sm">
                    <span>Xem toàn bộ @ViewBag.TotalOrders đơn</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>

            <div class="recent-table-responsive">
                <table class="adm-table">
                    <thead>
                        <tr>
                            <th style="width: 90px; text-align: center;">Mã Đơn</th>
                            <th style="width: 150px;">Thời Gian</th>
                            <th style="min-width: 200px;">Người Nhận &amp; Liên Hệ</th>
                            <th style="width: 140px; text-align: right;">Tổng Tiền</th>
                            <th style="width: 160px; text-align: center;">Trạng Thái</th>
                            <th style="width: 130px; text-align: center;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in recentOrders)
                        {
                            string vnSt = GetVnStatus(order.Status);
                            string recipientName = !string.IsNullOrWhiteSpace(order.RecipientName)
                                ? order.RecipientName.Trim()
                                : (order.Customer != null && !string.IsNullOrWhiteSpace(order.Customer.FullName)
                                    ? order.Customer.FullName.Trim()
                                    : "Khách mua hàng #" + order.OrderID);

                            string phone = !string.IsNullOrWhiteSpace(order.ShippingPhone)
                                ? order.ShippingPhone.Trim()
                                : (order.Customer != null && !string.IsNullOrWhiteSpace(order.Customer.Phone)
                                    ? order.Customer.Phone.Trim()
                                    : "Chưa có SĐT");
                            <tr>
                                <td style="text-align: center;">
                                    <span class="adm-order-code">#@order.OrderID</span>
                                </td>
                                <td>
                                    <div class="order-time-box">
                                        <strong>@order.OrderDate.ToString("dd/MM/yyyy")</strong>
                                        <small>@order.OrderDate.ToString("HH:mm:ss")</small>
                                    </div>
                                </td>
                                <td>
                                    <div class="order-customer-box">
                                        <div class="customer-name-row">
                                            <i class="fa-solid fa-circle-user"></i>
                                            <strong>@recipientName</strong>
                                        </div>
                                        <div class="customer-phone-row">
                                            <i class="fa-solid fa-phone"></i>
                                            <span>@phone</span>
                                        </div>
                                    </div>
                                </td>
                                <td style="text-align: right;">
                                    <strong class="adm-order-total">
                                        @string.Format("{0:N0} đ", order.TotalAmount)
                                    </strong>
                                </td>
                                <td style="text-align: center;">
                                    @if (vnSt == "Hoàn thành")
                                    {
                                        <span class="adm-badge-chip chip-success">
                                            <i class="fa-solid fa-check"></i> Hoàn thành
                                        </span>
                                    }
                                    else if (vnSt == "Đã hủy")
                                    {
                                        <span class="adm-badge-chip chip-danger">
                                            <i class="fa-solid fa-xmark"></i> Đã hủy
                                        </span>
                                    }
                                    else if (vnSt == "Đang giao")
                                    {
                                        <span class="adm-badge-chip chip-info">
                                            <i class="fa-solid fa-truck"></i> Đang giao
                                        </span>
                                    }
                                    else if (vnSt == "Đã xác nhận")
                                    {
                                        <span class="adm-badge-chip chip-info">
                                            <i class="fa-solid fa-clipboard-check"></i> Đã xác nhận
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="adm-badge-chip chip-warning">
                                            <i class="fa-solid fa-hourglass-half"></i> Chờ xử lý
                                        </span>
                                    }
                                </td>
                                <td style="text-align: center; white-space: nowrap;">
                                    <a href="@Url.Action("Details", "Orders", new { id = order.OrderID })" class="adm-view-btn" title="Xem chi tiết đơn hàng #@order.OrderID">
                                        <span>Chi tiết</span>
                                        <i class="fa-solid fa-chevron-right"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

<!-- STYLESHEET BẢO ĐẢM HIỂN THỊ CHUẨN ĐỒNG BỘ 100% (KHÔNG PHỤ THUỘC BROWSER CACHE) -->
<style>
    /* 1. KHUNG CHÍNH */
    .admin-dashboard-wrapper {
        padding: 2rem 0 3.5rem 0;
        max-width: 1200px;
        margin: 0 auto;
        font-family: 'Be Vietnam Pro', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    /* 2. HERO CARD */
    .admin-hero-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 1.75rem 2.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 4px 20px -2px rgba(17, 24, 39, 0.05);
        flex-wrap: wrap;
    }

    .admin-hero-left {
        flex: 1;
        min-width: 280px;
    }

    .admin-shield-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        background: rgba(194, 153, 88, 0.12);
        color: #b4853e;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.75px;
        text-transform: uppercase;
        margin-bottom: 0.4rem;
    }

    .admin-hero-title {
        font-size: 1.875rem;
        font-weight: 800;
        color: #111827;
        margin: 0;
        letter-spacing: -0.5px;
        line-height: 1.25;
    }

    .admin-hero-actions {
        display: flex;
        gap: 0.85rem;
        align-items: center;
        flex-wrap: wrap;
    }

    .adm-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.7rem 1.25rem;
        border-radius: 10px;
        font-size: 0.875rem;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s ease;
        cursor: pointer;
        white-space: nowrap;
    }

    .adm-btn-outline {
        background: #ffffff;
        color: #1e293b;
        border: 1px solid #cbd5e1;
    }
    .adm-btn-outline:hover {
        background: #f8fafc;
        border-color: #94a3b8;
        color: #0f172a;
        transform: translateY(-2px);
    }

    .adm-btn-sm {
        padding: 0.5rem 0.9rem;
        font-size: 0.8125rem;
    }

    /* 3. MODULES SECTION (3 CỘT CÂN ĐỐI) */
    .admin-modules-section {
        margin-bottom: 2.5rem;
    }

    .section-title-wrap {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.25rem;
    }

    .admin-section-heading {
        font-size: 1.35rem;
        font-weight: 800;
        color: #111827;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0 0 0.25rem 0;
    }
    .admin-section-heading i {
        color: #c29958;
    }

    .admin-section-sub {
        font-size: 0.875rem;
        color: #64748b;
        margin: 0;
    }

    .admin-modules-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }

    .adm-module-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 1.75rem;
        display: flex;
        flex-direction: column;
        position: relative;
        box-shadow: 0 2px 10px rgba(17, 24, 39, 0.04);
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .adm-module-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 14px 28px -6px rgba(17, 24, 39, 0.1);
        border-color: #cbd5e1;
    }

    .adm-module-badge {
        position: absolute;
        top: 1.5rem;
        right: 1.5rem;
        font-size: 0.6875rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 3px 8px;
        border-radius: 6px;
    }
    .badge-blue { background: #eff6ff; color: #1d4ed8; }
    .badge-purple { background: #faf5ff; color: #7e22ce; }
    .badge-amber { background: #fffbeb; color: #b45309; }

    .adm-module-icon-wrap {
        width: 52px;
        height: 52px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        margin-bottom: 1rem;
        transition: transform 0.2s ease;
    }
    .adm-module-card:hover .adm-module-icon-wrap {
        transform: scale(1.08);
    }
    .icon-blue { background: #eff6ff; color: #2563eb; }
    .icon-purple { background: #faf5ff; color: #9333ea; }
    .icon-amber { background: #fffbeb; color: #d97706; }

    .adm-module-title {
        font-size: 1.2rem;
        font-weight: 800;
        color: #111827;
        margin: 0 0 0.35rem 0;
    }

    .adm-module-stat {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.8125rem;
        color: #475569;
        margin-bottom: 0.85rem;
        padding: 4px 10px;
        background: #f8fafc;
        border-radius: 6px;
        border: 1px solid #f1f5f9;
        width: fit-content;
    }

    .adm-module-desc {
        color: #64748b;
        font-size: 0.875rem;
        line-height: 1.6;
        margin: 0 0 1.5rem 0;
        flex: 1;
    }

    .adm-module-actions {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .module-btn-primary {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 1rem;
        background: #111827;
        color: #ffffff;
        text-decoration: none;
        border-radius: 9px;
        font-size: 0.875rem;
        font-weight: 700;
        transition: all 0.2s ease;
    }
    .module-btn-primary:hover {
        background: #c29958;
        color: #ffffff;
    }

    .module-btn-sub {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.55rem 0.85rem;
        background: #f8fafc;
        color: #475569;
        text-decoration: none;
        border-radius: 8px;
        font-size: 0.8125rem;
        font-weight: 600;
        border: 1px solid #e2e8f0;
        transition: all 0.2s ease;
    }
    .module-btn-sub:hover {
        background: #ffffff;
        color: #111827;
        border-color: #cbd5e1;
    }

    /* 4. RECENT ORDERS TABLE */
    .admin-recent-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 1.75rem;
        box-shadow: 0 4px 20px -2px rgba(17, 24, 39, 0.05);
    }

    .admin-recent-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.25rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .recent-title {
        font-size: 1.15rem;
        font-weight: 800;
        color: #111827;
        margin: 0 0 0.25rem 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .recent-desc {
        color: #64748b;
        font-size: 0.8125rem;
        margin: 0;
    }

    .recent-table-responsive {
        overflow-x: auto;
    }

    .adm-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 0.875rem;
    }

    .adm-table th {
        background: #f8fafc;
        padding: 0.85rem 1rem;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #64748b;
        border-bottom: 1px solid #e2e8f0;
        white-space: nowrap;
    }

    .adm-table td {
        padding: 1rem;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }

    .adm-table tr:hover td {
        background: #f8fafc;
    }

    .adm-order-code {
        font-weight: 800;
        color: #111827;
        background: #f1f5f9;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.8125rem;
        display: inline-block;
    }

    .order-time-box strong {
        display: block;
        color: #1e293b;
        font-weight: 700;
        font-size: 0.875rem;
    }
    .order-time-box small {
        color: #94a3b8;
        font-size: 0.75rem;
    }

    /* ĐỒNG BỘ CẤU TRÚC NGƯỜI NHẬN & LIÊN HỆ */
    .order-customer-box {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .customer-name-row {
        display: flex;
        align-items: center;
        gap: 7px;
        color: #111827;
        font-size: 0.875rem;
    }

    .customer-name-row i {
        color: #64748b;
        font-size: 0.9rem;
    }

    .customer-phone-row {
        display: flex;
        align-items: center;
        gap: 7px;
        color: #64748b;
        font-size: 0.8125rem;
    }

    .customer-phone-row i {
        color: #94a3b8;
        font-size: 0.75rem;
    }

    .adm-order-total {
        color: #111827;
        font-size: 0.9375rem;
        font-weight: 800;
    }

    .adm-badge-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 700;
        white-space: nowrap;
    }
    .chip-warning { background: #fef3c7; color: #92400e; }
    .chip-info { background: #e0f2fe; color: #0369a1; }
    .chip-success { background: #dcfce7; color: #15803d; }
    .chip-danger { background: #fee2e2; color: #991b1b; }

    /* NÚT CHI TIẾT TRÊN 1 DÒNG DUY NHẤT */
    .adm-view-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 0.5rem 1rem;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        color: #1e293b;
        font-size: 0.8125rem;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap !important;
        min-width: 95px;
        transition: all 0.2s ease;
    }
    .adm-view-btn:hover {
        background: #111827;
        border-color: #111827;
        color: #ffffff;
        transform: translateY(-1px);
    }

    /* RESPONSIVE CHO MỌI THIẾT BỊ */
    @@media (max-width: 1024px) {
        .admin-modules-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 640px) {
        .admin-hero-card {
            padding: 1.5rem;
        }
    }
</style>
